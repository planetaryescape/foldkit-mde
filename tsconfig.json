{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["packages/core/src/**/*.ts", "packages/editor/src/**/*.ts", "packages/plugins/src/**/*.ts", "apps/*/src/**/*.ts"]
}
